# Copy file này thành config/robot_connection.env, sau đó điền giá trị của ROBOT THẬT.
# File robot_connection.env bị .gitignore để không public IP/cấu hình nội bộ.

export ROS_DOMAIN_ID=0
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
export ROS_LOCALHOST_ONLY=0
export ROBOT_NAMESPACE=/robot3

# Discovery Server: thay ROBOT_IP và cổng theo robot thực tế.
# Nếu robot dùng Simple Discovery, xóa/comment dòng export và dùng: unset ROS_DISCOVERY_SERVER
export ROS_DISCOVERY_SERVER=';;ROBOT_IP:11811;'
